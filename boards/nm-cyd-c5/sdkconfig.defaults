# NM-CYD-C5 proposed profile only. Not yet wired into CMake/build tooling.
# This file must not be used with the existing Waveshare-only capture.c
# and tools/verify_artifacts.py, both of which still mandate 32 MB.
CONFIG_IDF_TARGET="esp32c5"
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_SINGLE_APP=y
CONFIG_C5_UART_RX_GPIO=4
