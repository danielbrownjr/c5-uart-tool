menu "C5 UART capture"
    config C5_UART_RX_GPIO
        int "UART1 receive-only GPIO (verify board wiring before connecting)"
        range 4 4
        default 4
        help
            Waveshare NXRX profile: GPIO4 / P2 pin 8 in the OEM schematic.
            Verify physical revision and orientation before wiring.

    config C5_UART_BAUD
        int "UART receive baud rate"
        range 1200 2000000
        default 115200
endmenu
